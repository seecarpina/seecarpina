{
  "name": "see-carpina",
  "version": "1.0.0",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "see-carpina",
      "version": "1.0.0",
      "workspaces": [
        "secretaria",
        "gestao-escolar",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "gestao-escolar": {
      "name": "@see/gestores",
      "version": "1.0.0",
      "dependencies": {
        "@see/compartilhado": "1.0.0"
      }
    },
    "node_modules/@see/compartilhado": {
      "resolved": "packages/compartilhado",
      "link": true
    },
    "node_modules/@see/gestores": {
      "resolved": "gestao-escolar",
      "link": true
    },
    "node_modules/@see/secretaria": {
      "resolved": "secretaria",
      "link": true
    },
    "packages/compartilhado": {
      "name": "@see/compartilhado",
      "version": "1.0.0"
    },
    "secretaria": {
      "name": "@see/secretaria",
      "version": "1.0.0",
      "dependencies": {
        "@see/compartilhado": "1.0.0"
      }
    }
  }
}
